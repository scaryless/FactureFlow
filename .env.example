# API — ne jamais committer un vrai fichier .env
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
ANTHROPIC_API_KEY=replace-with-server-only-key

# Frontend autorisé à appeler l'API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://factureflow.evolutionb.ca

# Réception de factures par courriel via n8n
INBOUND_EMAIL_DOMAIN=factureflow.evolutionb.ca
INBOUND_EMAIL_SECRET=replace-with-a-long-random-secret
MAX_UPLOAD_BYTES=15728640
